# Copy this file to ".env" and fill in YOUR local values.
# ".env.example" is safe to commit. ".env" is private and is ignored by Git.

# --- Server ---
PORT=5000
# The address of the Vite frontend. Several addresses can be separated by commas.
CLIENT_ORIGIN=http://localhost:5173

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password_here
DB_NAME=petcare
# Philippine time (UTC+8), the same time zone the database scripts use
DB_TIMEZONE=+08:00

# --- Authentication ---
# A long random secret used to sign login tokens (at least 32 characters). Keep it private.
# Create your own with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
# How long a login lasts (a number followed by m, h or d)
JWT_EXPIRES_IN=8h
# How much work bcrypt does per password (4 to 15; 10 is a good default)
BCRYPT_ROUNDS=10